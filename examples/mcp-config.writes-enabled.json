{
  "mcpServers": {
    "arcnow": {
      "command": "node",
      "args": [
        "/absolute/path/to/arcnow-io/mcp/dist/index.js",
        "--allow-writes"
      ],
      "env": {
        "ARCNOW_MCP_NETWORK": "arc-testnet",
        "ARCNOW_PRIVATE_KEY_FILE": "/run/secrets/arcnow-signing-key",
        "ARCNOW_MCP_MAX_SPEND_USDC": "25"
      }
    }
  }
}
